/target
# cargo-fuzz builds in a detached workspace under fuzz/; its build dir and
# resolved lockfile are local artifacts, never committed.
/fuzz/target
/fuzz/Cargo.lock
/fuzz/corpus
/fuzz/artifacts
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.pdb

# Python build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node

# WASM build artifacts
bindings/wasm/pkg/

# Go: the C ABI library is staged per-platform by CI, never committed here.
bindings/go/lib/*/

# .NET build artifacts
bin/
obj/

# Java / Maven build artifacts
bindings/java/target/

# R build artifacts. configure/configure.win generate most of these: they stage
# the downloaded C ABI into src/ and write Makevars from Makevars.in. .Rbuildignore
# already lists them so they stay out of the package tarball; without the same
# list here, a `git add -A` after an R build commits a downloaded header and a
# generated import library.
bindings/r/.rlib/
bindings/r/..Rcheck/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/src/*.dll.a
bindings/r/src/*.dylib
bindings/r/src/*.def
bindings/r/src/symbols.rds
bindings/r/src/wickra_strategy_ci.h
bindings/r/src/Makevars
bindings/r/src/wickra-strategy-ci-c.tar.gz
bindings/r/src/wickra-strategy-ci-c/

# Local secrets — never commit credentials.
.env
.env.*
*.key
secrets/

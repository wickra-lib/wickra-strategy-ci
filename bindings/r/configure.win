#!/bin/sh
# Windows build: stage the C ABI DLL into src/ and build a mingw import library
# for it, so the package object links against it and install.libs.R bundles it.
#
# Unlike the wickra binding, no rename is needed here: the package compiles to
# wickrastrategyci.dll and the C ABI is wickra_strategy_ci.dll, so the loader
# cannot resolve one for the other.
#
# The release ships an MSVC import library (wickra_strategy_ci.dll.lib), which
# mingw cannot consume, so the import library is generated from the DLL's export
# list here.
#
# Self-contained by default: download the prebuilt
# wickra-strategy-ci-c-<triple>.tar.gz release asset matching this package's
# version. Set WKSTRATEGYCI_INC + WKSTRATEGYCI_LIB to build against a locally
# built C ABI instead (dev override).
set -e

wkstrategyci_download() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickra-strategy-ci: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating - retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickra-strategy-ci: failed to download ${_url} after 6 attempts"
  return 1
}

# Detect the R architecture, not the shell's. On the Windows/arm64 runner
# `uname -m` reports x86_64 (the shell runs under emulation), so the x64 C ABI
# would be pulled into an arm64 R and fail to load ("%1 is not a valid Win32
# application"). R.version$arch reflects the R build that loads the DLL, and it
# also selects the import library's target machine below.
arch=$("${R_HOME}/bin/Rscript" -e 'cat(R.version$arch)')
case "${arch}" in
  x86_64)
    triple="x86_64-pc-windows-msvc"
    dll_machine="i386:x86-64"
    ;;
  aarch64 | arm64)
    triple="aarch64-pc-windows-msvc"
    dll_machine="arm64"
    ;;
  *)
    echo "wickra-strategy-ci: unsupported Windows arch '${arch}' - set WKSTRATEGYCI_INC/WKSTRATEGYCI_LIB"
    exit 1
    ;;
esac

if [ -n "${WKSTRATEGYCI_INC}" ] && [ -n "${WKSTRATEGYCI_LIB}" ]; then
  echo "wickra-strategy-ci: using C ABI from WKSTRATEGYCI_INC / WKSTRATEGYCI_LIB (dev override)"
  inc="${WKSTRATEGYCI_INC}"
  lib="${WKSTRATEGYCI_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  url="https://github.com/wickra-lib/wickra-strategy-ci/releases/download/v${version}/wickra-strategy-ci-c-${triple}.tar.gz"
  echo "wickra-strategy-ci: downloading C ABI ${triple} for v${version}"
  wkstrategyci_download "${url}" "src/wickra-strategy-ci-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-strategy-ci-c.tar.gz', exdir = 'src/wickra-strategy-ci-c')"
  inc="src/wickra-strategy-ci-c/wickra-strategy-ci-c-${triple}/include"
  lib="src/wickra-strategy-ci-c/wickra-strategy-ci-c-${triple}/lib"
fi

cp "${inc}/wickra_strategy_ci.h" src/wickra_strategy_ci.h
cp "${lib}/wickra_strategy_ci.dll" src/wickra_strategy_ci.dll

# Take the export list from the staged header rather than by dumping the DLL.
# cbindgen declares exactly the exported symbols, so header and PE export table
# agree entry for entry, and reading the header needs no binutils at all: the
# objdump that resolves on Windows/arm64 is the runner image's x86_64 mingw copy,
# which carries no aarch64 PE backend and rejects an arm64 DLL with
# "file format not recognized".
{
  echo 'LIBRARY wickra_strategy_ci.dll'
  echo 'EXPORTS'
  awk '
    # Strip block and line comments first so a symbol mentioned in the generated
    # documentation is never mistaken for a declaration.
    BEGIN { inblock = 0 }
    {
      out = ""
      i = 1
      n = length($0)
      while (i <= n) {
        two = substr($0, i, 2)
        if (inblock) {
          if (two == "*/") { inblock = 0; i += 2 } else { i++ }
        } else if (two == "/*") {
          inblock = 1
          i += 2
        } else if (two == "//") {
          break
        } else {
          out = out substr($0, i, 1)
          i++
        }
      }
      print out
    }
  ' src/wickra_strategy_ci.h \
    | grep -oE '\bwickra_strategy_ci_[A-Za-z0-9_]*[[:space:]]*\(' \
    | sed 's/[[:space:]]*($//' \
    | LC_ALL=C sort -u
} > src/wickra_strategy_ci.def

# The import library has to target R's architecture. A binutils build only
# carries the PE backends it was configured with, so the x86_64 mingw dlltool
# that resolves on PATH cannot emit an arm64 library -- asked for one via -m it
# fails outright ("invalid bfd target") instead of quietly producing the wrong
# thing. That loud failure is what makes trying candidates in order safe: the
# first that succeeds is by construction one that can target this architecture.
# BINPREF is R's own pointer at the matching Rtools toolchain, and llvm-dlltool
# (shipped with the clang-based aarch64 Rtools) carries every backend.
BINPREF=$("${R_HOME}/bin/R" CMD config BINPREF 2>/dev/null | tr -d '\r') || BINPREF=""
dlltool_log="src/dlltool.log"
: > "${dlltool_log}"
DLLTOOL=""
for cand in "${WKSTRATEGYCI_DLLTOOL}" "${BINPREF}llvm-dlltool" "${BINPREF}dlltool" llvm-dlltool dlltool; do
  [ -n "${cand}" ] || continue
  echo "wickra-strategy-ci: trying ${cand} -m ${dll_machine}" >> "${dlltool_log}"
  if "${cand}" -m "${dll_machine}" --input-def src/wickra_strategy_ci.def \
      --dllname wickra_strategy_ci.dll --output-lib src/libwickra_strategy_ci.dll.a >> "${dlltool_log}" 2>&1; then
    DLLTOOL="${cand}"
    break
  fi
done
if [ -z "${DLLTOOL}" ]; then
  echo "wickra-strategy-ci: no dlltool could build a ${dll_machine} import library; attempts:"
  cat "${dlltool_log}"
  exit 1
fi
rm -f "${dlltool_log}"
echo "wickra-strategy-ci: import library built by ${DLLTOOL} (-m ${dll_machine})"
exit 0

# Generated into src/Makevars by ../configure (the @WKSTRATEGYCI_RPATH@ token is
# substituted per-OS: $ORIGIN on Linux, @loader_path on macOS). The C ABI header
# (wickra_strategy_ci.h) and shared library (libwickra_strategy_ci.so/.dylib)
# are staged into src/ by configure, so the package object links against the
# bundled lib.
PKG_CPPFLAGS = -I.
PKG_LIBS = -L. -lwickra_strategy_ci @WKSTRATEGYCI_RPATH@

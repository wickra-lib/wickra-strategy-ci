# Windows: configure.win stages wickra_strategy_ci.dll into src/ and builds the
# mingw import library libwickra_strategy_ci.dll.a beside it, so both the header
# and the library are found in the package's own src directory.
# install.libs.R then bundles the DLL, which the loader finds next to the
# package object.
PKG_CPPFLAGS = -I.
PKG_LIBS = -L. -lwickra_strategy_ci
